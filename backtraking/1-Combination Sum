'''1-Combination Sum'''
class Solution:
    def combinationSum(self, nums: List[int], target: int) -> List[List[int]]:
        


        result = [] 
        
        def backtrack(remaining, current_combination, start_index):
            

            if remaining == 0:
                result.append(list((current_combination)))
                return

            
            
            # bounding function: buraya "toplam > target" ya da "remaining < 0" kontrolünü ekle
            if  remaining<0:
                return


            
            
            # döngü: start_index'ten itibaren tüm elemanları dene
            for i in range(start_index, len(nums)): 

                current_combination.append(nums[i])       #İlk indeks elemanını current_combinationsa ekledik
                backtrack(remaining - nums[i], current_combination, i) #Bu current_combinations için backtracke yeni parametreleri verdik
                current_combination.pop()
        
        backtrack(target, [], 0)    
        return result













