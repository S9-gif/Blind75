'''2-Word Search'''
class Solution:
    def exist(self, board: List[List[str]], word: str) -> bool:
        

        rows = len(board)
        cols = len(board[0]) 
        visited = set()  # ziyaret edilen (row, col) çiftlerini tutacak indeks olarak

        def backtrack(row: int, col: int, k: int) -> bool:
            #Base case - tüm kelime eşleşti mi? (k == len(word))
            if (k == len(word)):
                return True
            
            #Base case - sınır dışı mı?
            if (row < 0 or row >= rows or col < 0 or col >= cols):
                return False
            
            #Base case - daha önce ziyaret edildi mi ya da
            if (row, col) in visited:
                return False

            #harf uyuşmuyor ise
            if board[row][col] != word[k]:
                return False
            
            # Buraya geldiysen: harf uyuşuyor demektir -> işaretle
            visited.add((row, col))
            
            #4 komşuya recursive çağrı yap (yukarı, aşağı, sağ, sol)
            for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                if backtrack(row+dr,col+dc,k+1):
                    return True
            found = False
            
            #Hiçbiri işe yaramadıysa -> işareti geri sil (backtrack)
            if not found:
                visited.remove((row, col))
            
            return found

       
        for r in range(rows):
            for c in range(cols):
                if board[r][c] == word[0]:
                    if backtrack(r, c, 0):
                         return True

        return False















