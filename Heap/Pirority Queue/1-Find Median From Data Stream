'''1-Find Median From Data Stream'''
class MedianFinder:

    def __init__(self):
        

        self.sayılar = [] 


    def addNum(self, num: int) -> None:
        
        i = 0
        while i < len(self.sayılar) and self.sayılar[i] < num:
            i += 1
        self.sayılar.insert(i, num)

        #Sonuç olarak bu fonksiyonun amacı verilen num parametresini class'In bir attribute'u olan sayılar listesine eklemek ve class'ı bir nevi güncellemek.Artık bu class bunda bötle bu lekilde bir sayılar listesine sahip demek.

    def findMedian(self) -> float:
        
        # Bu fonk çalıştırıldığında en güncel class attribute 'u olan sayılar listesi iiçin bu listeden medyan hesaplaması gerekli.Medyan listenin ortanca değeridir burda önce kontrol sağlayalım.

        if len(self.sayılar) % 2 == 0: #listedeki eleman sayısı çift ise

            slow, fast = 0, 0
            while fast + 2 < len(self.sayılar):
                slow += 1
                fast += 2

            self.medyan=(self.sayılar[slow]+self.sayılar[slow+1])/2 
            return self.medyan

            #Burda bu fonksiyon için böyle bir kod yazılabilir mi?
            #Ve şuanda sayılar lüstesi üzerinde gezmiyorlar gibi

        else:   #Listedeki eleman sayısı tek ise
        
            self.medyan=self.sayılar[(len(self.sayılar))//2]
            return self.medyan










