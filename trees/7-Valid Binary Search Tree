# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right

class Solution:
    def isValidBST(self, root: Optional[TreeNode]) -> bool:


       
        def check(node,left,right):



            if node is None:
                return True
                
            #Genel kontrol
            if not (left < node.val < right): 
                return False 
            
            #low ile high ile ilgli güncelleme vs işlemlerini burda yapıcam  

            return(check(node.left,left,node.val) and check(node.right,node.val,right))


            #sol çocuğa geçerken high, root olur ama bir llow sınır olmaz sağa geçerken de low root olur high için sınır yok

            
        return check(root,float('-inf'),float('inf'))   #Başlangıç parametresi root başlangıç sınırı root için sınırsızdır.












