'''11-Serialize and Deserialize Binary Tree'''
# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right

class Codec:
    
    # Encodes a tree to a single string.
    def serialize(self, root: Optional[TreeNode]) -> str:

        result = []
        
        def dfs(node):
            if node is None:
                result.append("N")#'N' null'u simgelesin diye
                return
            
            result.append (str(node.val))
            
            dfs(node.left)#Burda işte recursive çağtı olmalı

            dfs(node.right)

        dfs(root)   #Fomksiyonu çalıştırmak için
        return ",".join(result)   #Tek bir data olarak birleştirir.



    # Decodes your encoded data to tree.
    def deserialize(self, data: str) -> Optional[TreeNode]:

        values = data.split(",")    #Hadi bir şekilde data adı altında parçaladık diyelim.Elimde vales adında bir liste olması lazım şuanda

        def dfs():
            val=values.pop(0)

            if val =='N':
                return None


            node = TreeNode(int(val))   #pop ile alınan val değeri str idi bunu yine int çevirdim
            node.left = dfs()   #soldan devam
            node.right = dfs()  #Bitince sağdan devam

            return node
        return dfs()
            





