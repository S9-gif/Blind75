'''10-Binary Tree Maximum Path Sum'''
# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right

class Solution:
    def maxPathSum(self, root: Optional[TreeNode]) -> int:
        best = float('-inf')#Bütün ağaç elemanlarının negatif olması ihtimali için eksi sonsuz ile default yazdım.Kii ilk node ile karşılaşılınca ona atansın.
    
        def helper(node):
            nonlocal best#nonlocal fonksiyonun dışarıdaki best'i (kendi local kopyasını değil) okuyup güncelleyebilmesini sağlıyor.

            if node is None:#Base case fonksiyonun devamlılığı için return 0 olarak yazıldı None olsaydı hata alıcaktım.

                return 0

            sol = helper(node.left)
            sag = helper(node.right)#Burda bulunduğum parametre için sol ve sağ yollara bakıyorum.
            

            sol = max(sol, 0)
            sag = max(sag, 0)#Bir kol negatif sonuç döndürüyorsa Negatif kırpması yapıyorum 

            best = max(best, node.val + sol + sag)#Best güncelleniyor.

            return node.val + max(sol, sag)
    
        helper(root)
        return best







