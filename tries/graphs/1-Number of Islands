'''1-Number of Islands'''
class Solution:
    def numIslands(self, grid: List[List[str]]) -> int:
      
        if not grid:
            return 0
        
        rows, cols = len(grid), len(grid[0])
        visited = set()
        island_count = 0
        
        def dfs(r, c):
            # sınır kontrolü, su kontrolü, visited kontrolü

            if r<0 or r>=rows or c<0 or c >=cols  or grid[r][c] == '0' or(r,c) in visited:
                return

            else:
                visited.add((r,c))


            # 4 komşuyu (yukarı, aşağı, sol, sağ) dfs ile çağır

            #Burdaki for döngüsünden emin değilim?
            for dr,dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:

                dfs(r+dr, c+dc)

        

        #İmleç ile gezme ve recursion:
        for r in range(rows):
            for c in range(cols):
                if grid[r][c] == '1' and (r, c) not in visited:#İmleicin oynatıldığı index 1 ise ve visited da indeksleri yani hücrenin lokasyonu kaydedilmemiş ise bu durumda yeni bir kara parçasındayım demektir.Yani yeni bir ada bulduk.Bu nedenle ada sayısı arttırılır.
                    island_count += 1
                    dfs(r, c)#Bu noktada recursive döngü yapmak için dfs dedik ama dfs içine verilen parametreler üstten yani for döngüsünden sürekli gelen parametreler
        
        return island_count










